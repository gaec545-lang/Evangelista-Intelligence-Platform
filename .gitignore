# ============================================================
# EVANGELISTA & CO. — .gitignore
# Repositorio público: se excluye TODO el contenido sensible
# ============================================================

# ── Credenciales y Secretos ─────────────────────────────────
.env
.env.*
!.env.example

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/

# ── Node / Vite ─────────────────────────────────────────────
node_modules/
dist/
.vite/

# ── Contenido Propietario (NO publicar) ──────────────────────
# Vault de Obsidian — frameworks y metodologías propietarias
Evangelista-Obsidian/

# Contexto interno del negocio
Contexto/

# Instrucciones internas y prompts de IA
Instrucciones/

# RAG engine con datos propietarios
evangelista-rag/

# Información interna de la firma
Evangelista-info/

# Knowledge base y skills internos
Skills Evangelista/

# Configuración interna de AI assistant
.claude/
CLAUDE.md

# Herramienta interna de desarrollo
gstack/
comandos_gstack.md

# Archivos de debug y errores de compilación
*.txt
!README*.txt
*.log
*_errors.txt
*_errors_*.txt

# ── macOS Resource Forks (basura del sistema) ─────────────────
._*
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ── Bases de datos ───────────────────────────────────────────
qdrant_storage/
qdrant_storage_v2/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── Archivos temporales de build/dev ─────────────────────────
base64_*.txt
*_base64.txt
tsc_errors*.txt
fresh_tsc_errors.txt
final_tsc_errors.txt
.env*
._*
postgresql_binaries.zip
postgresql_installer.exe
.azure/
.azure_env
